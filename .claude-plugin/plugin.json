{
  "name": "astronomy-mcp-server",
  "version": "0.1.3",
  "description": "What's in the sky, computed offline — planet and moon positions, rise/set, phases, eclipses, and seasons for any place and time.",
  "author": {
    "name": "cyanheads"
  },
  "homepage": "https://github.com/cyanheads/astronomy-mcp-server",
  "repository": "https://github.com/cyanheads/astronomy-mcp-server",
  "license": "Apache-2.0",
  "mcpServers": {
    "astronomy-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/astronomy-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
