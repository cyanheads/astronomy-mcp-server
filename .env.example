# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=localhost           # HTTP host (default: localhost)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max request body bytes; 413 over limit, 0 disables (default: 1048576)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
# MCP_SESSION_MODE=stateful         # stateful | stateless (default: stateful)

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load (issue #50). Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# MCP_LOG_RATE_LIMIT_THRESHOLD=10   # Max emissions per level+message per window; 0 disables
# MCP_LOG_RATE_LIMIT_WINDOW_MS=60000

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP endpoint URL (e.g., http://localhost:4318)

# ── Server-specific ──────────────────────────────────────────────────
# All variables below are optional. The five core tools are keyless and
# offline and need no configuration; every variable here only gates or
# tunes the two network-backed extensions.

# Extension gates (off by default — the default deployment is keyless + offline)
# ASTRONOMY_ENABLE_HORIZONS=false     # Register astronomy_get_ephemeris (JPL Horizons small bodies / spacecraft)
# ASTRONOMY_ENABLE_SATELLITES=false   # Register astronomy_get_satellite_passes (CelesTrak TLE + SGP4)

# Observer-local time fallback
# ASTRONOMY_DEFAULT_TIMEZONE=         # Fallback IANA tz when a tool omits `timezone`; unset = UTC-only output

# Extension endpoint + tuning overrides
# ASTRONOMY_HORIZONS_BASE_URL=https://ssd.jpl.nasa.gov/api/horizons.api    # JPL Horizons API endpoint
# ASTRONOMY_CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php # CelesTrak GP/TLE endpoint
# ASTRONOMY_REQUEST_TIMEOUT_MS=15000  # HTTP timeout (ms) for Horizons and CelesTrak requests
# ASTRONOMY_TLE_CACHE_TTL_MS=7200000  # In-process TLE cache TTL (ms); default 2h per CelesTrak refetch guidance
